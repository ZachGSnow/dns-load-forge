# Normalise line endings in the repository to LF; check out natively per OS.
* text=auto

# Windows-only script types keep CRLF on checkout everywhere.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell scripts must stay LF or they break on Linux.
*.sh   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.ico  binary
*.gif  binary
*.webp binary
*.pdf  binary
*.zip  binary

# The dashboard page and its notices are built from web/ (npm run build). LF everywhere,
# because the server hashes the page's inline scripts for its Content-Security-Policy;
# marked generated so pull-request diffs collapse them.
src/dnsloadforge/dashboard/index.html              text eol=lf linguist-generated=true
src/dnsloadforge/dashboard/THIRD_PARTY_NOTICES.txt text eol=lf linguist-generated=true
web/package-lock.json                              linguist-generated=true
